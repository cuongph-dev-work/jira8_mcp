# ---------------------------------------------------------------------------
# Jira connection
# ---------------------------------------------------------------------------

# Base URL of the internal Jira 8 instance (no trailing slash)
JIRA_BASE_URL=https://jira.yourcompany.com

# Optional: HTTP Basic Auth credentials. When both are set, Basic Auth is tried
# first for Jira REST calls. If Jira rejects it, the server falls back to
# Playwright login and then the stored session cookie.
#JIRA_EMAIL=you@yourcompany.com
#JIRA_PASSWORD=

# REST API path used to validate that the session is still alive.
# Jira 8 uses /rest/api/2/myself — returns 200 for authenticated users.
JIRA_VALIDATE_PATH=/rest/api/2/myself

# Local file path for persisted Playwright browser storage state (cookies)
JIRA_SESSION_FILE=.jira/session.json

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# GitLab (used by jira_sync_gitlab_review_defects)
# ---------------------------------------------------------------------------

# Personal access token with read_api (or api) scope.
# Export in the shell or set here: export GITLAB_TOKEN=glpat-...
GITLAB_TOKEN=

# Preferred for MCP users: inline JSON map in environment variable.
# Must be a stringified JSON object with the same shape as .jira/gitlab-projects.json.
# Example:
# GITLAB_PROJECTS_JSON={"PROJ":[{"name":"app-frontend","gitlabBaseUrl":"https://gitlab.example.com","projectPath":"group/app-frontend"}]}
GITLAB_PROJECTS_JSON=

# Optional: absolute path to GitLab project map JSON.
# Default:
# - local source checkout: <repo>/.jira/gitlab-projects.json
# - npm / npx package: ~/.jira/jira-mcp/gitlab-projects.json
#GITLAB_PROJECTS_FILE=

# Optional: absolute path to local dedup store for synced note IDs.
# Default:
# - local source checkout: <repo>/.jira/gitlab-review-defects.json
# - npm / npx package: ~/.jira/jira-mcp/gitlab-review-defects.json
#GITLAB_DEDUP_FILE=

# ---------------------------------------------------------------------------
# Playwright (used for SSO login bootstrap only)
# ---------------------------------------------------------------------------

# Set to true to run in headless mode.
# Keep false for SSO — most corporate IdPs block headless browsers.
PLAYWRIGHT_HEADLESS=false

# Browser engine: chromium | firefox | webkit
PLAYWRIGHT_BROWSER=chromium

# ---------------------------------------------------------------------------
# Attachment security
# ---------------------------------------------------------------------------

# Directory where downloaded attachments are saved (created if missing)
# Example: ATTACHMENT_WORKSPACE=/home/user/projects/my-app
ATTACHMENT_WORKSPACE=./downloads
